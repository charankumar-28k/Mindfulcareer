# ============================================================
# MINDFULCARER — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Edge Function Secrets ──────────────────────────
# Add these in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# (Do NOT put these in .env — they live only in the Supabase dashboard)
#
# SUPABASE_SERVICE_ROLE_KEY   — auto-available inside Edge Functions
# RAZORPAY_KEY_ID             — from Razorpay Dashboard → Settings → API Keys
# RAZORPAY_KEY_SECRET         — from Razorpay Dashboard → Settings → API Keys
# RAZORPAY_WEBHOOK_SECRET     — from Razorpay Dashboard → Webhooks → Secret
# ANTHROPIC_API_KEY           — from console.anthropic.com
# RESEND_API_KEY              — from resend.com (free: 3000 emails/month)
# FROM_EMAIL                  — e.g. noreply@mindfulcarer.in (verified in Resend)

# ── Razorpay Webhook Setup ───────────────────────────────────
# In Razorpay Dashboard → Webhooks, add:
#   URL: https://<your-project-ref>.supabase.co/functions/v1/verify-payment
#   Events: payment.captured, payment.failed
#   Secret: (same as RAZORPAY_WEBHOOK_SECRET above)
